#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_PROFILE_DIR="/data/services/content-publisher/browser-profile"
PROFILE_DIR="${PUBLISHER_BROWSER_PROFILE_DIR:-$DEFAULT_PROFILE_DIR}"
APP_URL="${PUBLISHER_APP_URL:-http://127.0.0.1:8080}"

info() { printf '\033[1;34m[content-publisher browser]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

canonical_path() {
  realpath -m -- "$1"
}

validate_profile_dir() {
  [[ -n "$PROFILE_DIR" ]] || fail "浏览器资料目录不能为空"
  [[ ! -L "$PROFILE_DIR" ]] || fail "浏览器资料目录不能是符号链接：$PROFILE_DIR"
  local canonical_root canonical_profile
  canonical_root="$(canonical_path "$ROOT_DIR")"
  canonical_profile="$(canonical_path "$PROFILE_DIR")"
  case "$canonical_profile/" in
    "$canonical_root/"*)
      fail "浏览器资料目录不能位于 Git 仓库内：$canonical_profile"
      ;;
  esac
  PROFILE_DIR="$canonical_profile"
}

validate_app_url() {
  [[ "$APP_URL" =~ ^https?://[^[:space:]]+$ ]] \
    || fail "PUBLISHER_APP_URL 必须是 http 或 https 地址"
}

find_browser() {
  if [[ -n "${PUBLISHER_BROWSER_BIN:-}" ]]; then
    [[ -x "$PUBLISHER_BROWSER_BIN" ]] \
      || fail "PUBLISHER_BROWSER_BIN 不可执行：$PUBLISHER_BROWSER_BIN"
    printf '%s\n' "$PUBLISHER_BROWSER_BIN"
    return
  fi
  local candidate
  for candidate in google-chrome-stable google-chrome chromium chromium-browser microsoft-edge-stable; do
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return
    fi
  done
  fail "未找到 Chrome、Chromium 或 Edge；可通过 PUBLISHER_BROWSER_BIN 指定浏览器路径"
}

prepare_profile() {
  [[ "${EUID:-$(id -u)}" -ne 0 ]] || fail "不要以 root 身份运行持久浏览器资料"
  umask 077
  install -d -m 0700 -- "$PROFILE_DIR"
  chmod 0700 -- "$PROFILE_DIR"
  printf '%s\n' "Content Publisher persistent browser profile" >"$PROFILE_DIR/.content-publisher-profile"
  chmod 0600 "$PROFILE_DIR/.content-publisher-profile"
}

open_browser() {
  validate_profile_dir
  validate_app_url
  prepare_profile
  local browser
  browser="$(find_browser)"
  info "使用持久浏览器资料：$PROFILE_DIR"
  info "平台 Cookie、LocalStorage 和登录会话由该浏览器资料保存"
  exec "$browser" \
    --user-data-dir="$PROFILE_DIR" \
    --profile-directory=Default \
    --no-first-run \
    --no-default-browser-check \
    "$APP_URL"
}

show_status() {
  validate_profile_dir
  validate_app_url
  printf '应用地址：%s\n' "$APP_URL"
  printf '浏览器资料：%s\n' "$PROFILE_DIR"
  if [[ -d "$PROFILE_DIR" ]]; then
    printf '资料状态：已创建\n'
    printf '目录权限：%s\n' "$(stat -c '%a' "$PROFILE_DIR")"
  else
    printf '资料状态：尚未创建，首次打开时自动创建\n'
  fi
  if browser="$(find_browser 2>/dev/null)"; then
    printf '浏览器：%s\n' "$browser"
  else
    printf '浏览器：未检测到，请设置 PUBLISHER_BROWSER_BIN\n'
  fi
}

case "${1:-open}" in
  open)
    open_browser
    ;;
  status)
    show_status
    ;;
  *)
    cat <<'USAGE'
用法：./scripts/browser-session [open|status]

环境变量：
  PUBLISHER_APP_URL              Content Publisher 地址，默认 http://127.0.0.1:8080
  PUBLISHER_BROWSER_PROFILE_DIR  持久浏览器资料目录
  PUBLISHER_BROWSER_BIN          Chrome、Chromium 或 Edge 可执行文件路径
USAGE
    exit 1
    ;;
esac
